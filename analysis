# 1. Categorização por Score (lógica)
def calcular_score_match(pet, adotante):
    score = 0
    if pet['nivel_energia'] == adotante['estilo_vida']: score += 40
    if pet['espaco_req'] <= adotante['espaco_disponivel']: score += 60
    return score

